# vi:si:et:sw=4:sts=4:ts=4:syntax=python
# -*- Mode: Python -*-
#
# What the FS-VD1000 actually runs, and nothing else.
#
# The stock gstreamer-1.0 package builds and ships 264 plugins. The appliance
# uses about 30 of them. Every extra one is two liabilities at once:
#
#   - a parser or a codec exposed to whatever arrives on the network, which has
#     to be watched for CVEs and rebuilt for ten years
#   - a licence obligation. The stock package carries x264, a52dec and the DVD
#     plugins, all GPL, and shipping any of them in a sold unit would place the
#     whole work under the GPL, for elements nothing here calls.
#
# `cerbero package mlitdecoder-1.0` builds only the recipes this package needs,
# so the list below decides the build as well as the tarball.
#
# The authority for which plugins are needed and why is
# packaging/components.json in the mlit-decoder repository. After a build,
#
#     scripts/gen-sbom.py --verify-prefix /opt/gstreamer-1.28.5-...
#
# compares what came out with that manifest in both directions and names
# anything GPL. The file groups below are the finest granularity cerbero
# offers, so a handful of neighbours come along inside a group; that check is
# what reports them, and what keeps the difference deliberate.


class Package(custom.GStreamer, package.Package):
    name = 'mlitdecoder-1.0-runtime'
    shortdesc = 'GStreamer runtime for the FS-VD1000'
    longdesc = 'The GStreamer plugins and libraries the FS-VD1000 application uses'
    uuid = '6f2c1a94-3d7e-4a51-9f0c-2b8d5e41c7a3'
    # No base-system-1.0. That package carries the whole font and image
    # rendering stack - cairo, pango, harfbuzz, freetype, fontconfig, gdk-pixbuf,
    # librsvg, the image codecs - for plugins this product does not ship. It put
    # 44 shared libraries in the prefix where 28 were reachable and 12 were
    # needed, and every one of them is a licence to notify and a CVE to watch
    # for ten years. The libraries the shipped plugins actually link are listed
    # below instead, and `ldd` over the built prefix is what says whether the
    # list is right; see scripts/collect-components.py in the mlit-decoder
    # repository.
    deps = []

    # Each entry is recipe:category. The categories ending in fsvd are file
    # groups added to the recipes for this product, naming the plugins one by
    # one: the stock groups are coarser than a plugin, and packaging by them
    # shipped 147 plugins including GPL ones nothing calls. See the comment on
    # files_plugins_fsvd in each recipe.
    files = [
        # libgstreamer, the plugin scanner, gst-inspect for diagnosing a unit
        # on site, and coreelements: queue, identity, tee, capsfilter, fakesink
        'gstreamer-1.0:bins:libs:fsvd:misc:lang:typelibs',

        # videotestsrc for the standby screen, videoconvertscale as the
        # software fallback, audioconvert, audioresample and volume for the
        # audio chain, typefindfunctions for the demuxers, alsa for HDMI audio
        'gst-plugins-base-1.0:libs:fsvd:lang:typelibs',

        # udp, rtpmanager, rtp (rtpmp2pdepay is added by a patch in this fork)
        # and rtsp; audioparsers, mpg123 and isomp4; deinterlace, videobox,
        # videocrop and multifile for splitmuxsink
        'gst-plugins-good-1.0:fsvd:lang',

        # videoparsersbad, va, tsdemux, mpegpsdemux, mpegtsmux and kmssink.
        # The libs carry libgstva-1.0 and libgstcodecs, which those link.
        'gst-plugins-bad-1.0:libs_fsvd:fsvd:lang:typelibs',

        # The audio decoders, and the software video fallback when VA is not
        # available. FFmpeg must be built without --enable-gpl; see the note in
        # packaging/components.json. The libraries it links, ffmpeg among
        # them, are in the list at the end: shipped without them the plugin is
        # present and fails to load, and the unit is silently left with no
        # audio decoder at all.
        'gst-libav-1.0:codecs_restricted',

        # rsrtp: rtpmp2tdepay2 and rtpmp2tpay2, the TS and TTS payloaders both
        # modes are built on. MPL-2.0.
        'gst-plugins-rs:fsvd:libs',

        # The application is Python and drives the pipeline through gi. Without
        # the bindings and the typelibs there is nothing to run.
        'gobject-introspection:libs:python:typelibs',
        'gst-python-1.0:python:plugins:libs',
        # The bindings without the cairo module; see files_python_fsvd in the
        # recipe for what that one module costs.
        'pygobject:python_fsvd:libs',

        # The libraries the plugins above link, and nothing else. Only libs:
        # the tools that came with them - gdk-pixbuf-csource, json-glib-format
        # - are what dragged in gdk-pixbuf, libtiff and libjpeg, and a unit has
        # no use for a developer utility.
        'bzip2:libs',        # libgstlibav links it
        'expat:libs',        # libgstpython links it
        'ffmpeg:libs',       # the audio decoders and the software fallback
        'glib:libs',         # the object system and main loop
        'libffi:libs',       # behind GObject introspection
        'mpg123:libs',       # MPEG-1 Audio Layer 2
        'orc:libs',          # the SIMD paths of the base plugins
        'pcre2:libs',        # the regular expressions inside glib
        'zlib:libs',         # glib and the muxers
    ]

    # Nothing here is developed against on the unit. The headers, the .pc files
    # and the static archives are what made the old devel tarball necessary,
    # and leaving them out halves what is delivered.
    files_devel = []
