 #ifdef G_OS_WIN32
@@ -237,6 +322,9 @@ gst_clock_overlay_set_property (GObject * object, guint prop_id,
 
   GST_OBJECT_LOCK (overlay);
   switch (prop_id) {
+    case PROP_TIME_MODE:
+      g_atomic_int_set (&overlay->time_mode, g_value_get_enum (value));
+      break;
     case PROP_TIMEFORMAT:
       g_free (overlay->format);
       overlay->format = g_value_dup_string (value);
@@ -264,6 +352,9 @@ gst_clock_overlay_get_property (GObject * object, guint prop_id,
 
