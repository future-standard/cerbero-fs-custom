diff --git a/ext/pango/gstclockoverlay.c b/ext/pango/gstclockoverlay.c
--- a/_p2_/ext/pango/gstclockoverlay.c
+++ b/_p2_/ext/pango/gstclockoverlay.c
@@ -57,9 +57,12 @@
 
 #define DEFAULT_PROP_TIMEFORMAT 	"%H:%M:%S"
 
+#define DEFAULT_TIME_MODE GST_CLOCK_OVERLAY_TIME_MODE_DEFAULT
+
 enum
 {
   PROP_0,
+  PROP_TIME_MODE,
   PROP_TIMEFORMAT,
   PROP_LAST
 };
@@ -75,14 +78,33 @@ static void gst_clock_overlay_set_proper
 static void gst_clock_overlay_get_property (GObject * object, guint prop_id,
     GValue * value, GParamSpec * pspec);
 
+#define GST_TYPE_CLOCK_OVERLAY_TIME_MODE (gst_clock_overlay_time_mode_type())
+static GType
+gst_clock_overlay_time_mode_type (void)
+{
+  static GType time_mode_type = 0;
+  static const GEnumValue modes[] = {
+    {GST_CLOCK_OVERLAY_TIME_MODE_DEFAULT, "default", "default"},
+    {GST_CLOCK_OVERLAY_TIME_MODE_BUFFER_TIME, "buffer-time", "buffer-time"},
+    {0, NULL, NULL},
+  };
+
+  if (!time_mode_type) {
+    time_mode_type = g_enum_register_static ("GstClockOverlayTimeMode", modes);
+  }
+  return time_mode_type;
+}
+
 static gchar *
-gst_clock_overlay_render_time (GstClockOverlay * overlay)
+gst_clock_overlay_render_time (GstClockOverlay * overlay,
+    GstBuffer * video_frame)
 {
 #ifdef HAVE_LOCALTIME_R
   struct tm dummy;
 #endif
   struct tm *t;
   time_t now;
+  GstClock *clock;
 #ifdef G_OS_WIN32
   gunichar2 buf[256];
 #else
@@ -91,6 +113,39 @@ gst_clock_overlay_render_time (GstClockO
 
   now = time (NULL);
 
+  /* buffer-time: show the wall-clock time the buffer belongs to instead of
+   * the time it is rendered at, by moving "now" back by how far the buffer
+   * lags the clock. This is done on the time_t, before it is broken down and
+   * formatted, so that it applies to the Windows (wcsftime) and the POSIX
+   * (strftime) branch alike. Without a clock the current time is shown. */
+  if (g_atomic_int_get (&overlay->time_mode) ==
+      GST_CLOCK_OVERLAY_TIME_MODE_BUFFER_TIME
+      && (clock = gst_element_get_clock (GST_ELEMENT_CAST (overlay)))) {
+    GstSegment *segment = &GST_BASE_TEXT_OVERLAY (overlay)->segment;
+    GstClockTime gst_now, gst_running_time, ts_buffer, buf_running_time;
+
+    gst_now = gst_clock_get_time (clock);
+    gst_object_unref (clock);
+
+    ts_buffer = GST_BUFFER_TIMESTAMP (video_frame);
+    if (!GST_CLOCK_TIME_IS_VALID (ts_buffer)) {
+      GST_DEBUG_OBJECT (overlay, "buffer without valid timestamp");
+      return g_strdup ("");
+    }
+
+    gst_running_time =
+        gst_segment_to_running_time (segment, GST_FORMAT_TIME, gst_now);
+    buf_running_time =
+        gst_segment_to_stream_time (segment, GST_FORMAT_TIME, ts_buffer);
+    GST_DEBUG_OBJECT (overlay, "gst_now: %" GST_TIME_FORMAT
+        " gst_running_time: %" GST_TIME_FORMAT
+        " buf_running_time: %" GST_TIME_FORMAT " buffer_ts: %" GST_TIME_FORMAT,
+        GST_TIME_ARGS (gst_now), GST_TIME_ARGS (gst_running_time),
+        GST_TIME_ARGS (buf_running_time), GST_TIME_ARGS (ts_buffer));
+
+    now -= GST_TIME_AS_SECONDS ((GstClockTimeDiff) (gst_running_time -
+            buf_running_time));
+  }
 #ifdef HAVE_LOCALTIME_R
   /* Need to call tzset explicitly when calling localtime_r for changes
    * to the timezone between calls to be visible.  */
@@ -127,8 +182,10 @@ gst_clock_overlay_get_text (GstBaseTextO
 
   txt = g_strdup (overlay->default_text);
 
+  time_str = gst_clock_overlay_render_time (clock_overlay, video_frame);
+
   GST_OBJECT_LOCK (overlay);
-  time_str = gst_clock_overlay_render_time (clock_overlay);
+
   GST_OBJECT_UNLOCK (overlay);
 
   if (txt != NULL && *txt != '\0') {
@@ -171,6 +228,11 @@ gst_clock_overlay_class_init (GstClockOv
       "Tim-Philipp Müller <tim@centricular.net>");
 
   gsttextoverlay_class->get_text = gst_clock_overlay_get_text;
+  
+  g_object_class_install_property (gobject_class, PROP_TIME_MODE,
+      g_param_spec_enum ("time-mode", "Time Mode", "What time to show",
+          GST_TYPE_CLOCK_OVERLAY_TIME_MODE, DEFAULT_TIME_MODE,
+          G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS));
 
   g_object_class_install_property (gobject_class, PROP_TIMEFORMAT,
       g_param_spec_string ("time-format", "Date/Time Format",
@@ -206,6 +268,7 @@ gst_clock_overlay_init (GstClockOverlay
   textoverlay->valign = GST_BASE_TEXT_OVERLAY_VALIGN_TOP;
   textoverlay->halign = GST_BASE_TEXT_OVERLAY_HALIGN_LEFT;
 
+  overlay->time_mode = DEFAULT_TIME_MODE;
   overlay->format = g_strdup (DEFAULT_PROP_TIMEFORMAT);
 
 #ifdef G_OS_WIN32
@@ -237,6 +300,9 @@ gst_clock_overlay_set_property (GObject
 
   GST_OBJECT_LOCK (overlay);
   switch (prop_id) {
+    case PROP_TIME_MODE:
+      g_atomic_int_set (&overlay->time_mode, g_value_get_enum (value));
+      break;
     case PROP_TIMEFORMAT:
       g_free (overlay->format);
       overlay->format = g_value_dup_string (value);
@@ -264,6 +330,9 @@ gst_clock_overlay_get_property (GObject
 
   GST_OBJECT_LOCK (overlay);
   switch (prop_id) {
+    case PROP_TIME_MODE:
+      g_value_set_enum (value, g_atomic_int_get (&overlay->time_mode));
+      break;
     case PROP_TIMEFORMAT:
       g_value_set_string (value, overlay->format);
       break;
