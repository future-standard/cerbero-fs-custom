@@ -299,6 +299,7 @@ enum
   PROP_EMIT_STATS,
   PROP_LATENCY,
   PROP_SEND_SCTE35_EVENTS,
+  PROP_WAIT_PCR,
   /* FILL ME */
 };
 
@@ -422,6 +423,11 @@ gst_ts_demux_class_init (GstTSDemuxClass
           G_MAXINT, DEFAULT_LATENCY,
           G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS));
 
+  g_object_class_install_property (gobject_class, PROP_WAIT_PCR,
+      g_param_spec_boolean ("wait-pcr", "Wait for PCR",
+          "Wait for PCR update before pushing buffers out", TRUE,
+          G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS));
+
   element_class = GST_ELEMENT_CLASS (klass);
   gst_element_class_add_pad_template (element_class,
       gst_static_pad_template_get (&video_template));
@@ -498,6 +504,7 @@ gst_ts_demux_init (GstTSDemux * demux)
   demux->flowcombiner = gst_flow_combiner_new ();
   demux->requested_program_number = -1;
   demux->program_number = -1;
+  demux->wait_pcr = TRUE;
   demux->latency = DEFAULT_LATENCY;
   gst_ts_demux_reset (base);
 
@@ -526,6 +533,9 @@ gst_ts_demux_set_property (GObject * obj
     case PROP_LATENCY:
       demux->latency = g_value_get_int (value);
       break;
+    case PROP_WAIT_PCR:
+      demux->wait_pcr = g_value_get_boolean (value);
+      break;
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
   }
@@ -550,6 +560,9 @@ gst_ts_demux_get_property (GObject * obj
     case PROP_LATENCY:
       g_value_set_int (value, demux->latency);
       break;
+    case PROP_WAIT_PCR:
+      g_value_set_boolean (value, demux->wait_pcr);
+      break;
     default:
       G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
   }
@@ -3722,7 +3735,8 @@ gst_ts_demux_push_pending_data (GstTSDem
       goto beach;
     }
 
-    if (G_UNLIKELY (stream->pending_ts && !check_pending_buffers (demux))) {
+    if (G_UNLIKELY (demux->wait_pcr && stream->pending_ts
+            && !check_pending_buffers (demux))) {
       if (buffer) {
         PendingBuffer *pend;
         pend = g_new0 (PendingBuffer, 1);
@@ -3781,7 +3795,7 @@ gst_ts_demux_push_pending_data (GstTSDem
       (GST_CLOCK_TIME_IS_VALID (stream->seeked_dts) &&
           stream->pts < stream->seeked_dts)) {
     GST_INFO_OBJECT (stream->pad,
-        "Droping with PTS: %" GST_TIME_FORMAT " DTS: %" GST_TIME_FORMAT
+       "Dropping with PTS: %" GST_TIME_FORMAT " DTS: %" GST_TIME_FORMAT
         " after seeking as other stream needed to be seeked further"
         "(seeked PTS: %" GST_TIME_FORMAT " DTS: %" GST_TIME_FORMAT ")",
         GST_TIME_ARGS (stream->pts), GST_TIME_ARGS (stream->dts),
@@ -3802,6 +3816,12 @@ gst_ts_demux_push_pending_data (GstTSDem
 
   if (GST_CLOCK_TIME_IS_VALID (stream->pts))
     GST_BUFFER_PTS (buffer) = GST_BUFFER_DTS (buffer) = stream->pts;
+  else
+    /* No PTS in the PES header: fall back to the arrival time of the input,
+     * for the DTS as well so that "DTS = PTS by default" still holds. A valid
+     * PTS is never replaced. */
+    GST_BUFFER_PTS (buffer) = GST_BUFFER_DTS (buffer) =
+        MPEG_TS_BASE_PACKETIZER (demux)->last_in_time;
   /* DTS = PTS by default, we override it if there's a real DTS */
   if (GST_CLOCK_TIME_IS_VALID (stream->dts))
     GST_BUFFER_DTS (buffer) = stream->dts;
