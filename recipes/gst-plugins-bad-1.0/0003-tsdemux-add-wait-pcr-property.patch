@@ -3525,9 +3539,13 @@ gst_ts_demux_push_pending_data (GstTSDemux * demux, TSDemuxStream * stream,
 
   if (GST_CLOCK_TIME_IS_VALID (stream->pts))
     GST_BUFFER_PTS (buffer) = GST_BUFFER_DTS (buffer) = stream->pts;
+  else
+    GST_BUFFER_PTS (buffer) = MPEG_TS_BASE_PACKETIZER (demux)->last_in_time;
   /* DTS = PTS by default, we override it if there's a real DTS */
   if (GST_CLOCK_TIME_IS_VALID (stream->dts))
     GST_BUFFER_DTS (buffer) = stream->dts;
+  else
+    GST_BUFFER_PTS (buffer) = MPEG_TS_BASE_PACKETIZER (demux)->last_in_time;
 
   if (stream->discont)
     GST_BUFFER_FLAG_SET (buffer, GST_BUFFER_FLAG_DISCONT);
