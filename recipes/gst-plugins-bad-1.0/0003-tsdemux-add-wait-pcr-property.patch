       if (buffer) {
         PendingBuffer *pend;
         pend = g_slice_new0 (PendingBuffer);
@@ -3504,7 +3518,7 @@ gst_ts_demux_push_pending_data (GstTSDemux * demux, TSDemuxStream * stream,
       (GST_CLOCK_TIME_IS_VALID (stream->seeked_dts) &&
